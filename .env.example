# ── Azure OpenAI (LLM API — GPT-4.1 mini deployment) ─────────────
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=your_azure_openai_key
# Your deployment NAME (not the model name) for gpt-4.1-mini
AZURE_OPENAI_DEPLOYMENT=gpt-4.1-mini
# AZURE_OPENAI_API_VERSION=2024-12-01-preview

# ── Azure AI Content Safety ("Azure guardrails") ─────────────────
# Endpoint of your Content Safety / Azure AI Services resource.
# The region is encoded in this URL, so there is no separate region var.
AZURE_CONTENT_SAFETY_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_CONTENT_SAFETY_KEY=your_content_safety_key

# Optional — override the defaults:
# Name of the custom blocklist to check (blank = skip blocklist matching).
AZURE_CONTENT_SAFETY_BLOCKLIST=jdqi-blocklist
# Harm-category severity (0–7) at/above which the pipeline is blocked.
AZURE_CONTENT_SAFETY_SEVERITY_THRESHOLD=4
